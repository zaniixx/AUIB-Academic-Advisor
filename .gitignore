__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
coverage/
*.tsbuildinfo

