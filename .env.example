# Copy to .env and fill in. Never commit .env.

# Database password, letters and digits only (it is part of the API's database address):
#   openssl rand -hex 32
# PostgreSQL keeps the password it was first created with; to change it later, see
# docs/operations.md (Routine tasks).
POSTGRES_PASSWORD=change-me

# The master token (ADR 0009), at least 32 characters:  openssl rand -hex 32
# It adds and removes admins (admin page, People tab) and opens the admin page in an emergency;
# admins otherwise sign in with their AUIB email. The key for sign-in codes is derived from it.
ADVISOR_ADMIN_TOKEN=

# Public address. ":80" serves plain HTTP (local use). A domain name such as
# advisor.example.edu turns on automatic HTTPS (needs ports 80 and 443 open).
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Sign-in (F9.1): students sign in with a code emailed to their @auib.edu.iq address.
# Optional: a separate key for hashing sign-in codes (at least 32 characters). Unset, it is derived
# from the master token.
ADVISOR_SECRET_KEY=
# The mail server that sends the codes: AUIB's own, or a service such as Mailgun, Postmark,
# SendGrid or Brevo. SECURITY is starttls (port 587), ssl (port 465) or none.
ADVISOR_MAIL_MODE=smtp
ADVISOR_SMTP_HOST=
ADVISOR_SMTP_PORT=587
ADVISOR_SMTP_SECURITY=starttls
ADVISOR_SMTP_USERNAME=
ADVISOR_SMTP_PASSWORD=
ADVISOR_SMTP_FROM=AUIB Academic Advisor <advisor@auib.edu.iq>
# Days a sign-in lasts.
ADVISOR_SESSION_DAYS=30
# To try the app on your own computer without a mail server, use ADVISOR_ENVIRONMENT=development
# and ADVISOR_MAIL_MODE=log: codes then appear in `docker compose logs api`. Never on a real server.

# Optional. The course and program data are sealed in the repository (ADR 0008); this key opens them
# for the import, and the project's maintainers keep it. Without it the app starts with the data the
# database has, possibly none, and admins add courses and programs in the admin page.
ADVISOR_DATA_KEY=

# Import the course catalog and the program packages on first start.
ADVISOR_AUTO_IMPORT=true
# Publish packages whose validation has warnings (never ones with errors). The CS
# package's only warning is the unconfirmed catalog year.
ADVISOR_AUTO_IMPORT_ACCEPT_WARNINGS=true

# Interactive API documentation at /api/docs.
ADVISOR_API_DOCS=false
# Planning requests per minute per client address.
ADVISOR_RATE_LIMIT_PER_MINUTE=60
ADVISOR_WORKERS=2
# Database connections per API worker (kept open, and extra at busy moments).
ADVISOR_DB_POOL_SIZE=5
ADVISOR_DB_MAX_OVERFLOW=10
ADVISOR_LOG_LEVEL=INFO

# Image tag used by docker compose.
APP_VERSION=latest
