        <mxCell id="m15" value="reload the&lt;br&gt;catalog cache" style="html=1;verticalAlign=middle;align=left;spacingLeft=8;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.8889;entryX=0.5;entryY=0.9192;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="w" target="w">
