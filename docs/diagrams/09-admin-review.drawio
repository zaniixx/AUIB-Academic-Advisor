<?xml version='1.0' encoding='utf-8'?>
<mxfile>
  <diagram id="seqlayout" name="Sequence: an admin checks and corrects a prerequisite rule">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1070" pageHeight="1240" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Sequence: an admin checks and corrects a prerequisite rule&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#555555&quot;&gt;Admins sign in with their AUIB email; their role is checked on every request, and every change is written to the audit log under their address. Other API workers pick it up on their next request.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="990" height="70" as="geometry" /></mxCell><mxCell id="u" value="Admin's browser (/admin)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#f1dae7;strokeColor=#cc79a7;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="100" height="1080" as="geometry" />
        </mxCell>
        <mxCell id="a" value="API (admin routes)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="120" width="100" height="1080" as="geometry" />
        </mxCell>
        <mxCell id="db" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#ccfff1;strokeColor=#009e73;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="120" width="100" height="1080" as="geometry" />
        </mxCell>
        <mxCell id="w" value="Other API workers" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="120" width="100" height="1080" as="geometry" />
        </mxCell>
        <mxCell id="act0" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="db">
          <mxGeometry x="45" y="200" width="10" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="db">
          <mxGeometry x="45" y="360" width="10" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="a">
          <mxGeometry x="45" y="150" width="10" height="310" as="geometry" />
        </mxCell>
        <mxCell id="act3" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="a">
          <mxGeometry x="45" y="510" width="10" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act4" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="db">
          <mxGeometry x="45" y="660" width="10" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act5" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="a">
          <mxGeometry x="45" y="610" width="10" height="150" as="geometry" />
        </mxCell>
        <mxCell id="act6" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="db">
          <mxGeometry x="45" y="870" width="10" height="50" as="geometry" />
        </mxCell>
        <mxCell id="note0" value="every request goes over HTTPS through Caddy" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8cc;strokeColor=#8f7c00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;spacingLeft=6;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="110" y="190" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="GET /api/v1/admin/rules + session cookie" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1389;entryX=0;entryY=0.0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="u" target="act2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="session and staff role" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1613;entryX=0;entryY=0.0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="act2" target="act0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="admin: name@auib.edu.iq" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.3226;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="act0" target="act2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note4" value="not an admin: 403" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8cc;strokeColor=#8f7c00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;spacingLeft=6;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="360" y="400" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="rules needing review" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6774;entryX=0;entryY=0.0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="act2" target="act1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="rules and their SIS sentences" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.8387;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="act1" target="act2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="review queue" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.4259;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="act2" target="u">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="POST /admin/rules/check (rule language)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.4722;entryX=0;entryY=0.0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="u" target="act3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="plain-English preview or the error" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.5185;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="act3" target="u">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="PUT /admin/rules/{id} (correction + note)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.5648;entryX=0;entryY=0.0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="u" target="act5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="save · audit_log row · revision + 1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3333;entryX=0;entryY=0.0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="act5" target="act4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="committed" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.6667;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="act4" target="act5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m13" value="updated rule" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.7037;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="act5" target="u">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note14" value="on its next request" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8cc;strokeColor=#8f7c00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;spacingLeft=6;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="860" y="910" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m15" value="read catalog revision" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.8056;entryX=1;entryY=0.0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="w" target="act6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m16" value="changed" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=1;exitY=1.0;entryX=0.5;entryY=0.8519;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="act6" target="w">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m17" value="reload the&lt;br&gt;catalog cache" style="html=1;verticalAlign=middle;align=left;spacingLeft=8;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.8981;entryX=0.5;entryY=0.9259;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="w" target="w">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="900" y="1090" /><mxPoint x="900" y="1120" /></Array>
