          <mxGeometry x="45" y="780" width="10" height="50" as="geometry" />
        </mxCell>
        <mxCell id="note0" value="every request goes over HTTPS through Caddy" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8cc;strokeColor=#8f7c00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;spacingLeft=6;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="110" y="190" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="GET /api/v1/admin/rules + Bearer token" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1515;entryX=0;entryY=0.0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="u" target="act1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="check the token&lt;br&gt;(constant time)" style="html=1;verticalAlign=middle;align=left;spacingLeft=8;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.2273;entryX=1;entryY=0.3636;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="act1" target="act1">
