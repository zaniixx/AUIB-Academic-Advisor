        <mxCell id="m6" value="POST /admin/rules/check (rule language)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.4242;entryX=0;entryY=0.0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="u" target="act2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="plain-English preview or the error" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.4747;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="act2" target="u">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="PUT /admin/rules/{id} (correction + note)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.5253;entryX=0;entryY=0.0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="u" target="act4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="save · audit_log row · revision + 1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3333;entryX=0;entryY=0.0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="act4" target="act3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="committed" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.6667;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="act3" target="act4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="updated rule" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.6768;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="act4" target="u">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note12" value="on its next request" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8cc;strokeColor=#8f7c00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;spacingLeft=6;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="860" y="820" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m13" value="read catalog revision" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.7879;entryX=1;entryY=0.0;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="w" target="act5">
          <mxGeometry relative="1" as="geometry" />
