<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="05-data-pipeline" name="05-data-pipeline">
    <mxGraphModel dx="1580" dy="930" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="930" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value='&lt;b&gt;Catalog data: from SIS to a published program&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 13px" color="#555555"&gt;Who does what when a program is added or refreshed. Adding a program needs no code changes.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="50" as="geometry"/></mxCell>
        <mxCell id="l1" value="Data maintainer's computer" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#e6e6e6;strokeColor=#555555;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="240" y="90" width="1300" height="190" as="geometry"/></mxCell>
        <mxCell id="l2" value="Repository (git)" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#e6e6e6;strokeColor=#555555;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="240" y="290" width="1300" height="170" as="geometry"/></mxCell>
        <mxCell id="l3" value="Server (API container)" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#e6e6e6;strokeColor=#555555;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="240" y="470" width="1300" height="230" as="geometry"/></mxCell>
        <mxCell id="l4" value="Admin (/admin page)" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#e6e6e6;strokeColor=#555555;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="240" y="710" width="1300" height="180" as="geometry"/></mxCell>
        <mxCell id="sis" value="&lt;b&gt;AUIB SIS&lt;/b&gt;&lt;br&gt;read with the maintainer's&lt;br&gt;own login" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#555555;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;SIS scraper&lt;/b&gt;&lt;br&gt;Playwright, read-only browsing" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="l1"><mxGeometry x="50" y="50" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="m3" value="&lt;b&gt;sis_data/ raw output&lt;/b&gt;&lt;br&gt;private: browser session and&lt;br&gt;personal progress; git-ignored" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe3cc;strokeColor=#d55e00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="l1"><mxGeometry x="340" y="40" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="m4" value="&lt;b&gt;prepare_program_package.py&lt;/b&gt;&lt;br&gt;drops personal fields, merges duplicate&lt;br&gt;groups, cleans text, keeps&lt;br&gt;hand-kept offering seasons" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="l1"><mxGeometry x="660" y="40" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="r1" value="&lt;b&gt;data/catalog/courses.json (shared)&lt;/b&gt;&lt;br&gt;data/programs/&amp;lt;id&amp;gt;/: program.json,&lt;br&gt;requirements.json; minors written&lt;br&gt;from official announcements; a person&lt;br&gt;reviews labels, roles, catalog year" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fff8cc;strokeColor=#8f7c00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="l2"><mxGeometry x="660" y="40" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="mig" value="&lt;b&gt;Database migrations&lt;/b&gt;&lt;br&gt;alembic upgrade head runs whenever the API starts;&lt;br&gt;for example 0002 marks the CS internships summer-only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#555555;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="l3"><mxGeometry x="50" y="40" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="i1" value="&lt;b&gt;Validate&lt;/b&gt;&lt;br&gt;errors block the import;&lt;br&gt;warnings block publishing" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffefcc;strokeColor=#e69f00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="l3"><mxGeometry x="670" y="40" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="i2" value="&lt;b&gt;Import (repeatable)&lt;/b&gt;&lt;br&gt;upsert courses, re-parse rules&lt;br&gt;keep admin corrections&lt;br&gt;flag changed SIS text&lt;br&gt;import run + audit log&lt;br&gt;catalog revision + 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfff1;strokeColor=#009e73;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="l3"><mxGeometry x="1020" y="30" width="240" height="140" as="geometry"/></mxCell>
        <mxCell id="a1" value="&lt;b&gt;Review queue&lt;/b&gt;&lt;br&gt;each rule beside its SIS sentence" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1dae7;strokeColor=#cc79a7;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="l4"><mxGeometry x="1020" y="40" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="a2" value="&lt;b&gt;Approve, or correct&lt;/b&gt;&lt;br&gt;in the rule language, with a note" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1dae7;strokeColor=#cc79a7;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="l4"><mxGeometry x="660" y="40" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="a3" value="&lt;b&gt;Saved&lt;/b&gt;&lt;br&gt;audit log + revision bump;&lt;br&gt;plans use it at once" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfff1;strokeColor=#009e73;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="l4"><mxGeometry x="300" y="40" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="sm2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sis" target="m2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
