        <mxCell id="e12" value="import" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cli" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="eD" value="D · /admin: rules, courses, programs, schedules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2727;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="admin" target="caddy"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="440"/><mxPoint x="940" y="440"/></Array></mxGeometry></mxCell>
        <mxCell id="facts" value="&lt;b&gt;Key facts for auditors&lt;/b&gt;&lt;br&gt;• A student's course history is processed in memory for each request; it is never stored or logged on the server.&lt;br&gt;• Only Caddy can be reached from outside; PostgreSQL sits on a network with no route in or out.&lt;br&gt;• Every admin action is written to the audit log.&lt;br&gt;• Catalog data comes from SIS; the registrar's degree audit stays the authority." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#555555;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1520" y="90" width="300" height="210" as="geometry"/></mxCell>
