  <diagram id="00-overview" name="00-overview">
    <mxGraphModel dx="1860" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="860" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;AUIB Academic Advisor: how the system works&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#555555&quot;&gt;Students plan in their own browser; the server computes plans and keeps only catalog data. Steps 1-3 are a student's visit, A-D how catalog data gets in.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1780" height="50" as="geometry"/></mxCell>
        <mxCell id="student" value="Student" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="155" width="40" height="70" as="geometry"/></mxCell>
        <mxCell id="browser" value="Student's browser" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#ccedff;strokeColor=#0072b2;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="240" y="90" width="380" height="320" as="geometry"/></mxCell>
        <mxCell id="pages" value="&lt;b&gt;Web app pages&lt;/b&gt;&lt;br&gt;Start · Plan · Degree map · Courses · Privacy" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="browser"><mxGeometry x="30" y="50" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="storage" value="&lt;b&gt;Browser storage&lt;/b&gt;&lt;br&gt;courses, grades and goals stay on this device;&lt;br&gt;“Clear my data” removes them" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1dae7;strokeColor=#cc79a7;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="browser"><mxGeometry x="30" y="210" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="admin" value="Data maintainer / admin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="545" width="40" height="70" as="geometry"/></mxCell>
        <mxCell id="maint" value="Data maintainer's computer" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#e6e6e6;strokeColor=#555555;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="240" y="480" width="380" height="330" as="geometry"/></mxCell>
        <mxCell id="scraper" value="&lt;b&gt;SIS scraper (Playwright)&lt;/b&gt;&lt;br&gt;run by hand, read-only browsing" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="maint"><mxGeometry x="30" y="60" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="raw" value="&lt;b&gt;Raw output: sis_data/&lt;/b&gt;&lt;br&gt;browser session and personal progress;&lt;br&gt;git-ignored, never deployed" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe3cc;strokeColor=#d55e00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="maint"><mxGeometry x="30" y="200" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="sis" value="&lt;b&gt;AUIB SIS&lt;/b&gt;&lt;br&gt;read with the maintainer's&lt;br&gt;own login" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#555555;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="server" value="AUIB Advisor server (Docker Compose)" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#ccedff;strokeColor=#0072b2;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="840" y="90" width="640" height="720" as="geometry"/></mxCell>
        <mxCell id="caddy" value="&lt;b&gt;Caddy reverse proxy&lt;/b&gt;&lt;br&gt;HTTPS · the only public entry point" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffefcc;strokeColor=#e69f00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="server"><mxGeometry x="40" y="50" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="web" value="&lt;b&gt;Web app server (Next.js)&lt;/b&gt;&lt;br&gt;serves the pages" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="server"><mxGeometry x="380" y="50" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;API + planning engine&lt;/b&gt;&lt;br&gt;(FastAPI) computes plans in memory;&lt;br&gt;stores nothing about students" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="server"><mxGeometry x="380" y="200" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;catalog, rules, import runs,&lt;br&gt;audit log" style="shape=cylinder3;size=12;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#ccfff1;strokeColor=#009e73;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="server"><mxGeometry x="380" y="390" width="220" height="130" as="geometry"/></mxCell>
        <mxCell id="pkg" value="&lt;b&gt;Course catalog + programs&lt;/b&gt;&lt;br&gt;data/catalog, data/programs,&lt;br&gt;copied into the API image" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fff8cc;strokeColor=#8f7c00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="server"><mxGeometry x="40" y="590" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="cli" value="&lt;b&gt;Import command&lt;/b&gt;&lt;br&gt;python -m app.cli&lt;br&gt;validates, then imports" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff8cc;strokeColor=#8f7c00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="server"><mxGeometry x="380" y="590" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="e1" value="1 · opens the app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="student" target="pages"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="2 · pasted history saved here" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=classic;startFill=1;" edge="1" parent="1" source="pages" target="storage"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="3 · HTTPS: pages, plan requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=classic;startFill=1;" edge="1" parent="1" source="pages" target="caddy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
