<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="04-planning-engine" name="04-planning-engine">
    <mxGraphModel dx="1300" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="960" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Planning engine: from a student's courses to a term-by-term plan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#555555&quot;&gt;Runs in memory for each request in about 20 ms. The same input always gives the same plan.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1220" height="50" as="geometry"/></mxCell>
        <mxCell id="inputs" value="Inputs" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#e6e6e6;strokeColor=#555555;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="300" height="600" as="geometry"/></mxCell>
        <mxCell id="in_student" value="&lt;b&gt;Sent by the student's browser&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="inputs"><mxGeometry x="20" y="40" width="260" height="20" as="geometry"/></mxCell>
        <mxCell id="in1" value="&lt;b&gt;Course attempts&lt;/b&gt;&lt;br&gt;completed, in progress, failed;&lt;br&gt;grades and terms" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1dae7;strokeColor=#cc79a7;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="inputs"><mxGeometry x="20" y="70" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="in2" value="&lt;b&gt;Preferences&lt;/b&gt;&lt;br&gt;usual and maximum load · pace&lt;br&gt;summers · kept, added, hidden courses&lt;br&gt;interests and goal" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1dae7;strokeColor=#cc79a7;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="inputs"><mxGeometry x="20" y="160" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="in_sep" value="&lt;b&gt;From the catalog (database)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="inputs"><mxGeometry x="20" y="280" width="260" height="20" as="geometry"/></mxCell>
        <mxCell id="in3" value="&lt;b&gt;Requirement trees&lt;/b&gt;&lt;br&gt;the major and minor, in the versions&lt;br&gt;for when the student joined" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfff1;strokeColor=#009e73;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="inputs"><mxGeometry x="20" y="310" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="in4" value="&lt;b&gt;Requisite rules&lt;/b&gt;&lt;br&gt;parsed, plus admin corrections" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfff1;strokeColor=#009e73;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="inputs"><mxGeometry x="20" y="400" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="in5" value="&lt;b&gt;Seasons and term schedules&lt;/b&gt;&lt;br&gt;internships: summer only; a term&lt;br&gt;with a schedule: only its courses" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfff1;strokeColor=#009e73;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="inputs"><mxGeometry x="20" y="490" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;1 · Student record&lt;/b&gt;&lt;br&gt;best attempt per course;&lt;br&gt;in-progress courses assumed passed" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="440" height="80" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;2 · Progress&lt;/b&gt;&lt;br&gt;each course counts toward one requirement,&lt;br&gt;in the order SIS lists them" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="220" width="440" height="80" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;3 · Selection&lt;/b&gt;&lt;br&gt;required courses and the prerequisites they need;&lt;br&gt;then the minor's courses, also counting toward the major;&lt;br&gt;major electives by interest, never lengthening the longest chain;&lt;br&gt;open-choice slots for the rest" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="340" width="440" height="120" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;4 · Scheduling, term by term&lt;/b&gt;&lt;br&gt;the course runs that term: its season, or the term's schedule;&lt;br&gt;prerequisites done in an earlier term, corequisites in the same term;&lt;br&gt;class standing; 15 credits usual, 18 maximum;&lt;br&gt;order: longest chain, year-level courses, electives' share, the rest" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="490" width="440" height="150" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;5 · Replace-with options&lt;/b&gt;&lt;br&gt;for each open choice: other courses of the same&lt;br&gt;requirement that fit that term" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="680" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="is1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="inputs" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s1s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s2s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s3s4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s4s5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="outputs" value="Response (nothing is stored)" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#ccedff;strokeColor=#0072b2;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="940" y="80" width="320" height="720" as="geometry"/></mxCell>
        <mxCell id="o1" value="&lt;b&gt;Plan by term&lt;/b&gt;&lt;br&gt;graduation and on-time terms" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="outputs"><mxGeometry x="20" y="50" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="o2" value="&lt;b&gt;Progress and what's left&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="outputs"><mxGeometry x="20" y="150" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="o3" value="&lt;b&gt;Courses eligible next term&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="outputs"><mxGeometry x="20" y="250" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="o4" value="&lt;b&gt;Degree map&lt;/b&gt;&lt;br&gt;courses by term, prerequisite links" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="outputs"><mxGeometry x="20" y="350" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="o5" value="&lt;b&gt;GPA card&lt;/b&gt;&lt;br&gt;CGPA, last term, retake suggestions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="outputs"><mxGeometry x="20" y="450" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="o6" value="&lt;b&gt;Warnings and advisor checks&lt;/b&gt;&lt;br&gt;consent, placement, unclear rules" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="outputs"><mxGeometry x="20" y="550" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="s5o" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8958;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="outputs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="whatif" value="&lt;b&gt;What if I drop or delay a course?&lt;/b&gt;&lt;br&gt;drop: an in-progress course counts as withdrawn&lt;br&gt;delay: the course may not start before next term&lt;br&gt;runs steps 1-5 again and lists the new&lt;br&gt;graduation term and every course that moves" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff8cc;strokeColor=#8f7c00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="wi" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="whatif" target="s4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="800"/><mxPoint x="380" y="565"/></Array></mxGeometry></mxCell>
        <mxCell id="adv" value="&lt;b&gt;Never blocking&lt;/b&gt;&lt;br&gt;Conditions the app cannot check (instructor consent, placement&lt;br&gt;tests, unclear SIS text) are shown to the student and never hide a course." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#555555;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="420" y="810" width="440" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
