<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="01-deployment" name="01-deployment">
    <mxGraphModel dx="1860" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="920" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value='&lt;b&gt;Deployment: Docker Compose on one server&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 13px" color="#555555"&gt;Four containers on two networks. Only the proxy publishes ports; the database network has no route in or out.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1780" height="50" as="geometry"/></mxCell>
        <mxCell id="users" value="Students and admins" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="40" height="70" as="geometry"/></mxCell>
        <mxCell id="host" value="Server: any machine with Docker Engine and Compose" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#e6e6e6;strokeColor=#555555;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="210" y="80" width="1290" height="800" as="geometry"/></mxCell>
        <mxCell id="front" value="frontend network" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#ccedff;strokeColor=#0072b2;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;" vertex="1" parent="host"><mxGeometry x="30" y="50" width="800" height="260" as="geometry"/></mxCell>
        <mxCell id="proxy" value="&lt;b&gt;proxy&lt;/b&gt;&lt;br&gt;caddy:2-alpine&lt;br&gt;ports 80 and 443&lt;br&gt;TLS certificates" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffefcc;strokeColor=#e69f00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="front"><mxGeometry x="30" y="80" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="web" value="&lt;b&gt;web&lt;/b&gt;&lt;br&gt;Next.js standalone server&lt;br&gt;port 3000, internal only&lt;br&gt;non-root user" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="front"><mxGeometry x="290" y="80" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;api&lt;/b&gt;&lt;br&gt;FastAPI + uvicorn, non-root&lt;br&gt;port 8000, internal only&lt;br&gt;joins both networks" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="front"><mxGeometry x="560" y="80" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="back" value='backend network&lt;br&gt;&lt;span style="font-weight: normal; font-size: 12px"&gt;internal: no route in or out&lt;/span&gt;' style="swimlane;startSize=50;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#ccfff1;strokeColor=#009e73;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;align=left;spacingLeft=10;" vertex="1" parent="host"><mxGeometry x="430" y="390" width="400" height="300" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b&gt;db&lt;/b&gt;&lt;br&gt;postgres:17-alpine&lt;br&gt;no published port" style="shape=cylinder3;size=12;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#ccfff1;strokeColor=#009e73;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="back"><mxGeometry x="160" y="90" width="210" height="130" as="geometry"/></mxCell>
        <mxCell id="caddy_data" value="&lt;b&gt;caddy_data&lt;/b&gt;&lt;br&gt;certificates" style="shape=cylinder3;size=12;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#555555;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="host"><mxGeometry x="50" y="390" width="100" height="90" as="geometry"/></mxCell>
        <mxCell id="caddy_config" value="&lt;b&gt;caddy_config&lt;/b&gt;" style="shape=cylinder3;size=12;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#555555;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="host"><mxGeometry x="170" y="390" width="100" height="90" as="geometry"/></mxCell>
        <mxCell id="pgdata" value="&lt;b&gt;pgdata&lt;/b&gt;&lt;br&gt;database files" style="shape=cylinder3;size=12;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#555555;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="host"><mxGeometry x="880" y="500" width="130" height="90" as="geometry"/></mxCell>
        <mxCell id="env" value="&lt;b&gt;.env on the server only (git-ignored)&lt;/b&gt;&lt;br&gt;POSTGRES_PASSWORD: db and api&lt;br&gt;ADVISOR_ADMIN_TOKEN: api&lt;br&gt;SITE_ADDRESS: proxy (a domain turns on HTTPS)&lt;br&gt;rate limit, workers, log level: api" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f1dae7;strokeColor=#cc79a7;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="host"><mxGeometry x="880" y="60" width="380" height="130" as="geometry"/></mxCell>
        <mxCell id="startup" value="&lt;b&gt;Start-up order (health checks)&lt;/b&gt;&lt;br&gt;1. db answers pg_isready&lt;br&gt;2. api runs alembic upgrade head and imports the&lt;br&gt;    courses and any program not imported yet&lt;br&gt;3. web starts once api is healthy&lt;br&gt;4. proxy starts once web is healthy" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#555555;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="host"><mxGeometry x="880" y="220" width="380" height="150" as="geometry"/></mxCell>
        <mxCell id="backup" value="&lt;b&gt;scripts/backup-db.sh&lt;/b&gt;&lt;br&gt;pg_dump to backups/; encrypt before copying off the server" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fff8cc;strokeColor=#8f7c00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="host"><mxGeometry x="880" y="710" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="u1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="proxy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p1" value="pages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="proxy" target="web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p2" value="/api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="proxy" target="api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="180"/><mxPoint x="905" y="180"/></Array></mxGeometry></mxCell>
        <mxCell id="a1" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
