<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="02-web-app" name="02-web-app">
    <mxGraphModel dx="1600" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Web app (Next.js): pages, browser storage and API calls&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#555555&quot;&gt;Pages run in the browser. A student's data lives in browser storage and leaves it only inside an API request.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1520" height="50" as="geometry"/></mxCell>
        <mxCell id="browser" value="Browser (student or admin)" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#ccedff;strokeColor=#0072b2;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1060" height="840" as="geometry"/></mxCell>
        <mxCell id="pages" value="Pages" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#ccedff;strokeColor=#0072b2;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;" vertex="1" parent="browser"><mxGeometry x="30" y="50" width="400" height="760" as="geometry"/></mxCell>
        <mxCell id="home" value="&lt;b&gt;/  Home&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="pages"><mxGeometry x="30" y="50" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="start" value="&lt;b&gt;/start  set-up in 4 steps&lt;/b&gt;&lt;br&gt;1 Program: major, optional minor&lt;br&gt;2 Paste the SIS Course History&lt;br&gt;3 Check and fix the courses read&lt;br&gt;4 Interests, goal, workload, pace" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="pages"><mxGeometry x="30" y="120" width="340" height="130" as="geometry"/></mxCell>
        <mxCell id="plan" value="&lt;b&gt;/plan  dashboard&lt;/b&gt;&lt;br&gt;Summary and GPA card (CGPA, last term, retakes)&lt;br&gt;Degree map&lt;br&gt;Term by term: Replace with · Keep in term · What if&lt;br&gt;Requirements and what's left&lt;br&gt;Next term · Electives for you · Things to check" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="pages"><mxGeometry x="30" y="270" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="print" value="&lt;b&gt;/plan/print  document for the advisor&lt;/b&gt;&lt;br&gt;A4 · semester in detail · all terms (optional) · sign-off" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="pages"><mxGeometry x="30" y="450" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="courses" value="&lt;b&gt;/courses and /courses/[code]&lt;/b&gt;&lt;br&gt;each rule beside its SIS sentence" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="pages"><mxGeometry x="30" y="530" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="privacy" value="&lt;b&gt;/privacy&lt;/b&gt;&lt;br&gt;Clear my data" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="pages"><mxGeometry x="30" y="610" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="adminp" value="&lt;b&gt;/admin&lt;/b&gt;&lt;br&gt;rules · imports · audit" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1dae7;strokeColor=#cc79a7;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="pages"><mxGeometry x="210" y="610" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="pnote" value="The web server only sends pages and scripts. Every API call, including a student's courses, goes from the browser to the API through Caddy." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="pages"><mxGeometry x="30" y="688" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="storage" value="&lt;b&gt;localStorage “auib-advisor:profile”&lt;/b&gt;&lt;br&gt;program · course attempts · grades · preferences&lt;br&gt;written by /start, updated by /plan, read by /plan/print;&lt;br&gt;removed by “Clear my data”" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1dae7;strokeColor=#cc79a7;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="browser"><mxGeometry x="540" y="90" width="480" height="110" as="geometry"/></mxCell>
        <mxCell id="client" value="&lt;b&gt;Typed API client (src/lib/api.ts)&lt;/b&gt;&lt;br&gt;types generated from the API's OpenAPI schema&lt;br&gt;same-origin requests to /api only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="browser"><mxGeometry x="540" y="380" width="480" height="100" as="geometry"/></mxCell>
        <mxCell id="session" value="&lt;b&gt;sessionStorage: admin token&lt;/b&gt;&lt;br&gt;forgotten when the tab closes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1dae7;strokeColor=#cc79a7;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="browser"><mxGeometry x="540" y="655" width="480" height="70" as="geometry"/></mxCell>
        <mxCell id="apis" value="API endpoints (through Caddy)" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#ccedff;strokeColor=#0072b2;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1160" y="80" width="400" height="840" as="geometry"/></mxCell>
        <mxCell id="cat" value="&lt;b&gt;Catalog (read only)&lt;/b&gt;&lt;br&gt;GET /api/v1/meta · /programs · /programs/{id}&lt;br&gt;GET /api/v1/courses · /courses/{code}&lt;br&gt;GET /api/v1/programs/{id}/insights" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="apis"><mxGeometry x="30" y="60" width="340" height="120" as="geometry"/></mxCell>
        <mxCell id="planner" value="&lt;b&gt;Planning (stateless, rate limited)&lt;/b&gt;&lt;br&gt;POST /api/v1/history/parse&lt;br&gt;POST /api/v1/planner/plan · /progress&lt;br&gt;POST /api/v1/planner/what-if&lt;br&gt;POST /api/v1/planner/recommendations" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="apis"><mxGeometry x="30" y="240" width="340" height="150" as="geometry"/></mxCell>
        <mxCell id="adm" value="&lt;b&gt;Admin (Bearer token, audited)&lt;/b&gt;&lt;br&gt;GET /api/v1/admin/rules · POST /rules/check&lt;br&gt;PUT /rules/{id} · POST /rules/{id}/approve&lt;br&gt;DELETE /rules/{id}/override&lt;br&gt;GET /api/v1/admin/imports · /audit" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1dae7;strokeColor=#cc79a7;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="apis"><mxGeometry x="30" y="460" width="340" height="150" as="geometry"/></mxCell>
        <mxCell id="health" value="&lt;b&gt;Health&lt;/b&gt;&lt;br&gt;GET /api/health · /api/ready" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="apis"><mxGeometry x="30" y="680" width="340" height="80" as="geometry"/></mxCell>
        <mxCell id="w1" value="profile" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.125;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=classic;startFill=1;" edge="1" parent="1" source="pages" target="storage"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="w2" value="API calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pages" target="client"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="w3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=classic;startFill=1;" edge="1" parent="1" source="adminp" target="session"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="cat"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="480"/><mxPoint x="1110" y="200"/></Array></mxGeometry></mxCell>
        <mxCell id="c2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="planner"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="500"/><mxPoint x="1130" y="395"/></Array></mxGeometry></mxCell>
        <mxCell id="c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="adm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="520"/><mxPoint x="1130" y="615"/></Array></mxGeometry></mxCell>
        <mxCell id="c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="health"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="540"/><mxPoint x="1110" y="800"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
