<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="01b-heroku" name="01b-heroku">
    <mxGraphModel dx="1720" dy="780" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="780" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Deployment on Heroku: one container per app&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#555555&quot;&gt;Heroku's router provides HTTPS. Caddy, the API and the web server share one web dyno built from Dockerfile.heroku; the database is the Heroku Postgres add-on.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1640" height="50" as="geometry"/></mxCell>
        <mxCell id="users" value="Students and admins" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="300" width="40" height="70" as="geometry"/></mxCell>
        <mxCell id="router" value="&lt;b&gt;Heroku router&lt;/b&gt;&lt;br&gt;HTTPS and certificates (ACM)&lt;br&gt;appends the visitor's address&lt;br&gt;to X-Forwarded-For" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffefcc;strokeColor=#e69f00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="200" y="270" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="dyno" value='Web dyno&lt;br&gt;&lt;span style="font-weight: normal; font-size: 12px"&gt;Dockerfile.heroku, non-root&lt;/span&gt;' style="swimlane;startSize=50;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#ccedff;strokeColor=#0072b2;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="490" y="110" width="640" height="560" as="geometry"/></mxCell>
        <mxCell id="caddy" value="&lt;b&gt;Caddy on $PORT&lt;/b&gt;&lt;br&gt;HTTP to HTTPS redirect&lt;br&gt;body limits, security headers" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffefcc;strokeColor=#e69f00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="dyno"><mxGeometry x="30" y="165" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="web" value="&lt;b&gt;Next.js server&lt;/b&gt;&lt;br&gt;127.0.0.1:3000 only&lt;br&gt;pages" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="dyno"><mxGeometry x="330" y="70" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;API (uvicorn)&lt;/b&gt;&lt;br&gt;127.0.0.1:8000 only&lt;br&gt;client address: the last one&lt;br&gt;Heroku's router added" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="dyno"><mxGeometry x="330" y="270" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="start" value="&lt;b&gt;start.sh&lt;/b&gt;&lt;br&gt;starts all three; if one stops, the dyno exits&lt;br&gt;and Heroku restarts it" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#555555;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="dyno"><mxGeometry x="30" y="450" width="570" height="80" as="geometry"/></mxCell>
        <mxCell id="pg" value="&lt;b&gt;Heroku Postgres&lt;/b&gt;&lt;br&gt;add-on, sets DATABASE_URL&lt;br&gt;TLS required" style="shape=cylinder3;size=12;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#ccfff1;strokeColor=#009e73;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1210" y="400" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="release" value="&lt;b&gt;Release phase: release.sh&lt;/b&gt;&lt;br&gt;alembic upgrade head&lt;br&gt;import new program packages&lt;br&gt;runs before each release goes live" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff8cc;strokeColor=#8f7c00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1210" y="170" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="config" value="&lt;b&gt;Config vars (Settings tab)&lt;/b&gt;&lt;br&gt;ADVISOR_ADMIN_TOKEN, ADVISOR_SECRET_KEY&lt;br&gt;ADVISOR_SMTP_* (mail for sign-in codes)&lt;br&gt;DATABASE_URL (from the add-on)&lt;br&gt;workers, pool size, rate limit" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f1dae7;strokeColor=#cc79a7;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1210" y="570" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="mail" value="&lt;b&gt;Mail provider&lt;/b&gt;&lt;br&gt;SMTP over TLS:&lt;br&gt;sign-in codes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#555555;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1540" y="505" width="160" height="90" as="geometry"/></mxCell>
