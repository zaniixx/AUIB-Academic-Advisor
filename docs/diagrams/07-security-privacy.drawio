      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value='&lt;b&gt;Security and privacy: trust boundaries and the data that crosses them&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 13px" color="#555555"&gt;Dashed boxes are trust boundaries. Labels on arrows say what data moves; boxes say how it is protected.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1680" height="50" as="geometry"/></mxCell>
        <mxCell id="z1" value="Student's device" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#f1dae7;strokeColor=#cc79a7;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;dashed=1;dashPattern=8 4;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="380" height="380" as="geometry"/></mxCell>
        <mxCell id="pages" value="&lt;b&gt;Web app pages&lt;/b&gt;&lt;br&gt;status shown by icon and word;&lt;br&gt;automated WCAG 2.1 AA checks" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="z1"><mxGeometry x="30" y="60" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="ls" value="&lt;b&gt;localStorage profile&lt;/b&gt;&lt;br&gt;courses · grades · goals&lt;br&gt;sent only inside a plan request;&lt;br&gt;“Clear my data” deletes it" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1dae7;strokeColor=#cc79a7;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="z1"><mxGeometry x="30" y="200" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="z6" value="Admin's device" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#f1dae7;strokeColor=#cc79a7;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;dashed=1;dashPattern=8 4;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="380" height="280" as="geometry"/></mxCell>
        <mxCell id="adminp" value="&lt;b&gt;/admin page&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1dae7;strokeColor=#cc79a7;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="z6"><mxGeometry x="30" y="60" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="ss" value="&lt;b&gt;sessionStorage: admin token&lt;/b&gt;&lt;br&gt;forgotten when the tab closes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1dae7;strokeColor=#cc79a7;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="z6"><mxGeometry x="30" y="170" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="z3" value="Server: public edge" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#ffefcc;strokeColor=#e69f00;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;dashed=1;dashPattern=8 4;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="260" height="380" as="geometry"/></mxCell>
        <mxCell id="caddy" value="&lt;b&gt;Caddy&lt;/b&gt;&lt;br&gt;TLS certificates · HSTS&lt;br&gt;bodies over 1 MB refused&lt;br&gt;access log" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffefcc;strokeColor=#e69f00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="z3"><mxGeometry x="30" y="60" width="200" height="160" as="geometry"/></mxCell>
        <mxCell id="z4" value="Server: frontend network" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#ccedff;strokeColor=#0072b2;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;dashed=1;dashPattern=8 4;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="900" y="90" width="440" height="380" as="geometry"/></mxCell>
        <mxCell id="web" value="&lt;b&gt;Web server (Next.js)&lt;/b&gt;&lt;br&gt;pages only · CSP and security headers" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="z4"><mxGeometry x="30" y="50" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;API (FastAPI)&lt;/b&gt;&lt;br&gt;input validation · 512 KB limit · rate limit&lt;br&gt;Cache-Control: no-store on plans&lt;br&gt;request bodies never logged or stored&lt;br&gt;admin: constant-time token check, audit log" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="z4"><mxGeometry x="30" y="180" width="380" height="150" as="geometry"/></mxCell>
