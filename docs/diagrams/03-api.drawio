      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value='&lt;b&gt;API (FastAPI): request pipeline, routes, planning logic and data access&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 13px" color="#555555"&gt;Every request passes the same protections. The planning logic is plain Python with no database or web code.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1700" height="50" as="geometry"/></mxCell>
        <mxCell id="in" value="&lt;b&gt;From Caddy&lt;/b&gt;&lt;br&gt;/api/*" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffefcc;strokeColor=#e69f00;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="140" height="90" as="geometry"/></mxCell>
        <mxCell id="mw" value="Middleware: runs on every request, in this order" style="swimlane;startSize=30;container=1;pointerEvents=0;collapsible=0;html=1;whiteSpace=wrap;fillColor=#f1dae7;strokeColor=#cc79a7;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=14;fontStyle=1;strokeWidth=2;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="220" y="80" width="1180" height="150" as="geometry"/></mxCell>
        <mxCell id="m1" value="&lt;b&gt;Request log&lt;/b&gt;&lt;br&gt;request ID, method, path,&lt;br&gt;status, time; never bodies" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccedff;strokeColor=#0072b2;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="mw"><mxGeometry x="20" y="40" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;Security headers&lt;/b&gt;&lt;br&gt;CSP · nosniff · frame deny;&lt;br&gt;no-store on planning and admin" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1dae7;strokeColor=#cc79a7;fontColor=#1a1a1a;fontFamily=Helvetica;fontSize=12;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="mw"><mxGeometry x="250" y="40" width="210" height="90" as="geometry"/></mxCell>
